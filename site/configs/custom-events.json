{
  "watch_files": ["/etc/passwd", "/etc/shadow", "/etc/sudoers", "/opt/app/config.json"],
  "watch_users": true,
  "auth_journal": true,
  "notify_score": 70,
  "rules": [
    {"id": "file-any-change", "description": "Watched file changed", "kinds": ["file_change"], "score": 70},
    {"id": "sudoers-permissions", "description": "Sudoers permissions or ownership changed", "kinds": ["file_change"], "paths": ["/etc/sudoers"], "changes": ["mode", "uid", "gid"], "score": 95},
    {"id": "app-config-size", "description": "Application configuration size changed", "kinds": ["file_change"], "paths": ["/opt/app/config.json"], "changes": ["size"], "score": 75},
    {"id": "user-created", "description": "Local account created", "kinds": ["user_created"], "score": 80},
    {"id": "user-changed", "description": "Local account details changed", "kinds": ["user_changed", "user_deleted"], "score": 75},
    {"id": "root-login", "description": "Root login reported by authentication service", "kinds": ["login"], "users": ["root"], "outcomes": ["success"], "score": 90},
    {"id": "login-failure", "description": "Authentication failure", "kinds": ["login"], "outcomes": ["failed"], "score": 45},
    {"id": "new-shell", "description": "New shell executed", "kinds": ["exec"], "processes": ["sh", "bash", "dash", "zsh", "ash", "ksh", "fish"], "score": 35}
  ]
}
