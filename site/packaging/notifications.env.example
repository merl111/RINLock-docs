# Copy to /etc/rinlock/notifications.env, owned by root with mode 0600.
# Keep only the variables needed for your configured destinations.
# Replace these placeholders locally. Never commit live URLs or credentials.
RINLOCK_SECURITY_URL=https://receiver.example.org/rinlock
RINLOCK_SECURITY_TOKEN=replace-locally
RINLOCK_SLACK_URL=https://hooks.slack.com/services/replace-locally
RINLOCK_NTFY_URL=https://ntfy.example.org
RINLOCK_NTFY_TOKEN=replace-locally
RINLOCK_SMTP_USERNAME=rinlock@example.org
RINLOCK_SMTP_PASSWORD=replace-locally
